{
  "realm": "ums",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@ums.local",
    "fromDisplayName": "University Management System"
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Can manage academic catalog, users, students, teachers, and operational records."
      },
      {
        "name": "TEACHER",
        "description": "Can manage teaching workflows such as attendance and assignments."
      },
      {
        "name": "STUDENT",
        "description": "Can access student-facing academic information."
      },
      {
        "name": "APPLICANT",
        "description": "Optional pre-admission role for a future public application flow."
      },
      {
        "name": "INTERNAL",
        "description": "Machine-only role for protected service-to-service endpoints."
      },
      {
        "name": "PROVISIONER",
        "description": "Machine-only role for creating and linking domain profiles."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ums-web",
      "name": "UMS Web Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "ums-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ums-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ]
    },
    {
      "clientId": "ums-api",
      "name": "UMS API Audience",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ums-internal",
      "name": "UMS Internal Service Client",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "local-internal-secret-change-me",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "ums-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ums-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ums-provisioner",
      "name": "UMS Identity Provisioner",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "local-provisioner-secret-change-me",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "ums.admin",
      "email": "admin@ums.local",
      "firstName": "Local",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "service-account-ums-internal",
      "enabled": true,
      "serviceAccountClientId": "ums-internal",
      "realmRoles": ["INTERNAL"]
    },
    {
      "username": "service-account-ums-provisioner",
      "enabled": true,
      "serviceAccountClientId": "ums-provisioner",
      "realmRoles": ["PROVISIONER"],
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ]
}
