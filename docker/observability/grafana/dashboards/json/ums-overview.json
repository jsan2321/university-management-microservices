{
  "title": "UMS service health",
  "schemaVersion": 39,
  "panels": [
    {"type":"stat","title":"Healthy scrape targets","targets":[{"expr":"sum(up{job=\"ums\"})"}]},
    {"type":"timeseries","title":"HTTP 5xx rate","targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"}]},
    {"type":"timeseries","title":"JVM heap used","targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)"}]}
  ]
}
