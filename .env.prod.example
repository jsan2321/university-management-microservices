# ─── Postgres ────────────────────────────────────────────
POSTGRES_USER=ums_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_PORT=5432

# ─── Keycloak ────────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_password
KC_HOSTNAME=auth.yourdomain.com

# ─── Service Database ────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=ums_admin
DB_PASSWORD=CHANGE_ME_strong_password

# ─── Security / OAuth2 ──────────────────────────────────
KEYCLOAK_ISSUER_URI=https://auth.yourdomain.com/realms/ums
KEYCLOAK_TOKEN_URI=https://auth.yourdomain.com/realms/ums/protocol/openid-connect/token
KEYCLOAK_BASE_URL=https://auth.yourdomain.com
KEYCLOAK_INTERNAL_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_PROVISIONER_CLIENT_SECRET=CHANGE_ME

# ─── API Gateway ─────────────────────────────────────────
FRONTEND_ALLOWED_ORIGINS=https://yourdomain.com

# ─── Redis (Rate Limiting) ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Observability ───────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

# ─── Spring Profile ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ─── Frontend Build Args ────────────────────────────────
VITE_KEYCLOAK_URL=https://auth.yourdomain.com
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_DEMO_MODE=false
